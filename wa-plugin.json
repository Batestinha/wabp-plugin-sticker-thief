  "eventSubscriptions": [
    "message",
    "plugin.job"
  ],
  "requiredPermissions": [
    "sticker-thief.manage"
  ],
  "requiredBotCapabilities": [],
  "dangerousActions": [],
  "backgroundJobs": [
    "sticker-thief.digest",
    "sticker-thief.deliver",
    "sticker-thief.backfill"
  ],
  "databases": [
    {
      "name": "stickers",
      "engine": "sqlite",
      "scope": "account",
      "migrations": "migrations/stickers"
    }
  ],
  "dataVersion": "2",
  "cancellation": {
    "workflows": []
  },
  "dependencies": [],
  "assistant": {
    "summary": "Collects stickers shared in managed groups, including those already in the chat archive, and sends them privately to members, on a subscription or on request.",
    "useCases": [
      "Subscribe a member to daily or weekly private sticker digests.",
      "Send a member the stickers they have not received yet, or a random selection.",
      "Report how many stickers have been collected and what is waiting for the member."
    ],
    "prerequisites": [
      "enabled=true in the target scope.",
      "The scope must be in ASSIST or MANAGE mode for stickers to be sent."
    ],
    "limitations": [
      "Only WebP stickers are collected; Lottie stickers are skipped.",
      "Deliveries arrive as native sticker packs of up to 30 stickers (still and animated kept apart) about every 15 seconds; with packs off, 10 single stickers about every 30 seconds.",
      "Stickers outside WhatsApp pack rules (512x512, at most 100 KB still or 500 KB animated) are always sent individually.",
      "Archive backfill needs WABP core API 0.3.16 and only reads stickers the chat archive still stores.",
      "Members only receive stickers collected in groups of the same scope."
    ],
    "workflows": [
      {
        "intent": "sticker_subscribe",
        "description": "Start or stop private sticker digests.",
        "commands": [
          "/stickers subscribe",
          "/stickers unsubscribe"
        ]
      },
      {
        "intent": "sticker_send",
        "description": "Send stickers to the member now.",
        "commands": [
          "/stickers send",
          "/stickers random",
          "/stickers resend"
        ]
      },
      {
        "intent": "sticker_status",
        "description": "Show collection size and subscription state.",
        "commands": [
          "/stickers status"
        ]
      }
    ]
  },
  "operatorConsole": {
    "configPaths": [
      "enabled",
      "collect",
      "includeAnimated",
      "maxStickerBytes",
      "digestSize",
      "manualSendLimit",
      "backfillArchive",
      "deliverAsPacks",
      "defaultCadence"
    ],
    "controls": [
      {
        "pluginId": "official.sticker-thief",
        "id": "plugin.official.sticker-thief.enabled",
        "path": "enabled",
        "label": "Enabled",
        "description": "Turn Sticker Thief on for this scope.",
        "section": "Sticker Thief",
        "order": 10,
        "schema": {
          "type": "boolean"
        },
        "ui": {
          "widget": "toggle",
          "helpText": "Turn Sticker Thief on for this scope."
        }
      },
      {
        "pluginId": "official.sticker-thief",
        "id": "plugin.official.sticker-thief.collect",
        "path": "collect",
        "label": "Collect new stickers",
        "description": "Save new stickers shared in this scope's groups.",
        "section": "Sticker Thief",
        "order": 20,
        "schema": {
          "type": "boolean"
        },
        "ui": {
          "widget": "toggle",
          "helpText": "Save new stickers shared in this scope's groups."
        }
      },
      {
        "pluginId": "official.sticker-thief",
        "id": "plugin.official.sticker-thief.includeAnimated",
        "path": "includeAnimated",
        "label": "Include animated stickers",
        "description": "Send animated stickers as well as still ones.",
        "section": "Sticker Thief",
        "order": 30,
        "schema": {
          "type": "boolean"
        },
        "ui": {
          "widget": "toggle",
          "helpText": "Send animated stickers as well as still ones."
        }
      },
      {
        "pluginId": "official.sticker-thief",
        "id": "plugin.official.sticker-thief.maxStickerBytes",
        "path": "maxStickerBytes",
        "label": "Maximum sticker size",
        "description": "Stickers larger than this are not collected.",
        "section": "Sticker Thief",
        "order": 40,
        "schema": {
          "type": "number",
          "unit": "bytes",
          "min": 1024,
          "max": 5242880
        },
        "ui": {
          "widget": "number",
          "helpText": "Stickers larger than this are not collected."
        }
      },
      {
        "pluginId": "official.sticker-thief",
        "id": "plugin.official.sticker-thief.digestSize",
        "path": "digestSize",
        "label": "Stickers per digest",
        "description": "Most stickers sent in one scheduled digest; 0 sends every new sticker.",
        "section": "Sticker Thief",
        "order": 50,
        "schema": {
          "type": "number",
          "min": 0,
          "max": 100000
        },
        "ui": {
          "widget": "number",
          "helpText": "Most stickers sent in one scheduled digest; 0 sends every new sticker."
        }
      },
      {
        "pluginId": "official.sticker-thief",
        "id": "plugin.official.sticker-thief.manualSendLimit",
        "path": "manualSendLimit",
        "label": "Stickers per request",
        "description": "Stickers sent for /stickers send or /stickers random without a number; 0 sends all of them.",
        "section": "Sticker Thief",
        "order": 60,
        "schema": {
          "type": "number",
          "min": 0,
          "max": 100000
        },
        "ui": {
          "widget": "number",
          "helpText": "Stickers sent for /stickers send or /stickers random without a number; 0 sends all of them."
        }
      },
      {
        "pluginId": "official.sticker-thief",
        "id": "plugin.official.sticker-thief.deliverAsPacks",
        "path": "deliverAsPacks",
        "label": "Send as sticker packs",
        "description": "Deliver stickers as native WhatsApp sticker packs of up to 30 (leftovers of 1-2, and stickers outside the WhatsApp pack rules, are sent individually). Turn off to send every sticker individually.",
        "section": "Sticker Thief",
        "order": 62,
        "schema": {
          "type": "boolean"
        },
        "ui": {
          "widget": "toggle",
          "helpText": "Deliver stickers as native WhatsApp sticker packs of up to 30 (leftovers of 1-2, and stickers outside the WhatsApp pack rules, are sent individually). Turn off to send every sticker individually."
        }
      },
      {
        "pluginId": "official.sticker-thief",
        "id": "plugin.official.sticker-thief.backfillArchive",
        "path": "backfillArchive",
        "label": "Import from chat archive",
        "description": "Also collect stickers already stored in this scope's chat archive.",
        "section": "Sticker Thief",
        "order": 65,
        "schema": {
          "type": "boolean"
        },
        "ui": {
          "widget": "toggle",
          "helpText": "Also collect stickers already stored in this scope's chat archive."
        }
      },
      {
        "pluginId": "official.sticker-thief",
        "id": "plugin.official.sticker-thief.defaultCadence",
        "path": "defaultCadence",
        "label": "Default cadence",
        "description": "Digest cadence used when a member subscribes without choosing one.",
        "section": "Sticker Thief",
        "order": 70,
        "schema": {
          "type": "enum",
          "enum": [
            {
              "value": "daily",
              "label": "Daily"
            },
            {
              "value": "weekly",
              "label": "Weekly"
            }
          ]
        },
        "ui": {
          "widget": "segmented",
          "helpText": "Digest cadence used when a member subscribes without choosing one."
        }
      }
    ],
    "internalConfigPaths": []
  }
}
